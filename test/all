#!/bin/bash
# Static validation: manifest, pure models, contract checks, and QML lint.
# Never mutates the primary session; safe for local runs and CI.

set -euo pipefail

PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
OMARCHY_SOURCE=${OMARCHY_PATH:-/usr/share/omarchy}

[[ -d $OMARCHY_SOURCE/shell ]] || {
  echo "Omarchy shell source not found: $OMARCHY_SOURCE" >&2
  exit 1
}

for test_file in "$PLUGIN_DIR"/test/*.test.js; do
  node "$test_file"
done

"$PLUGIN_DIR"/test/qml-smoke/run

OMARCHY_PATH="$OMARCHY_SOURCE" omarchy plugin validate "$PLUGIN_DIR"

for qml_file in "$PLUGIN_DIR"/*.qml "$PLUGIN_DIR"/ui/*.qml "$PLUGIN_DIR"/state/*.qml; do
  qmllint -I "$OMARCHY_SOURCE/shell" "$qml_file"
done

echo "ok - nexus manifest and QML"
